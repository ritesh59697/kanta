# Copy to .env and adjust. Read by `node --env-file=.env`.

# Network name from @midnight-ntwrk/midnight-js-utils `networks` (preview needs no API key).
KANTA_NETWORK=preview
# Only for preprod or mainnet (served by Blockfrost).
KANTA_BLOCKFROST_PROJECT_ID=
# Local proof server: docker run -p 6300:6300 midnightntwrk/proof-server:9.0.2 midnight-proof-server -v
KANTA_PROOF_SERVER_URL=http://localhost:6300

# Where the operator wallet seed, private-state DB and contract address live (git-ignored).
KANTA_DATA_DIR=data
KANTA_SEED_FILE=operator-seed.hex
# Encrypts the platform's private state (pay rules, operator secret) at rest. Needs 3+ of: upper, lower, digit, symbol.
KANTA_PRIVATE_STORE_PASSWORD=change-me-to-a-long-random-passphrase

# Minimum notice before a new pay rule comes into force (set at deploy, can't change later).
KANTA_NOTICE_SECONDS=600
# Length of a surge slot (fixed at deploy).
KANTA_SLOT_SECONDS=1800
# How long after its slot ends a trip can still be paid (fixed at deploy).
KANTA_SETTLE_SECONDS=3600
# Extra margin added to the notice period when announcing a rule, so block time can't overtake it.
KANTA_RULE_START_BUFFER_SECONDS=60

# Set after `npm run deploy` (also saved to KANTA_DATA_DIR/contract.json).
KANTA_CONTRACT_ADDRESS=

KANTA_PORT=8790
KANTA_CORS_ORIGIN=http://localhost:5210
# Wallet sync from scratch can take a few minutes.
KANTA_SYNC_TIMEOUT_MS=1800000
