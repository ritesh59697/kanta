# Platform console API (only the platform's own console uses it).
VITE_KANTA_API=http://localhost:8790
# Public Midnight indexer for the network the contract lives on (rider check + board use only this).
VITE_KANTA_INDEXER=https://indexer.preview.midnight.network/api/v4/graphql
# Deployed Kanta contract (the rider page can also read it from a receipt).
VITE_KANTA_CONTRACT=
VITE_KANTA_NETWORK=preview
# How far back (in slots) the public record looks for the last announced surge.
VITE_KANTA_BOARD_LOOKBACK_SLOTS=1440
# Landing page links (optional; each link is hidden when empty).
VITE_KANTA_VIDEO_URL=
VITE_KANTA_REPO_URL=
VITE_KANTA_VIDEO_POSTER=/kanta-demo-poster.jpg
